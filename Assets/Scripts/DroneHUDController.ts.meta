  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DroneHUDController – drone flight overlay orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 preflightCard {"hint":"Pre-flight card UI (Start flight button + battery)."}'
    - '// @input AssignableType_2 flightTag {"hint":"Billboarded flight tag beside the drone."}'
    - '// @input AssignableType_3 returnLine {"hint":"Amber return line from drone to home pad."}'
    - '// @input AssignableType_4 offViewArrow {"hint":"Off-view edge arrow."}'
    - '// @input SceneObject drone {"hint":"Stand-in drone root (moved along the scripted path)."}'
    - '// @input SceneObject homePad {"hint":"Home pad root (origin = pad centre on the floor). The drone takes off from and lands on it."}'
    - '// @input SceneObject contentRoot {"hint":"Root of all world content. Placed on the floor in front of the user at Lens start."}'
    - "// @input SceneObject viewer {\"hint\":\"The user's camera object.\"}"
    - "// @input Component.AudioComponent droneAudio {\"hint\":\"AudioComponent on the drone that plays the return chime (spatial, from the drone's position).\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float drainSeconds = 40 {"hint":"Seconds from takeoff until the battery drains from 100% to the return threshold.", "widget":"slider", "min":10, "max":120, "step":1}'
    - '// @input float returnBatteryPercent = 30 {"hint":"Battery % at which the drone returns home (tag turns amber, line + chime).", "widget":"slider", "min":10, "max":60, "step":1}'
    - '// @input float cruiseAltitudeCm = 175 {"hint":"Cruise height above the floor in cm (about head height).", "widget":"slider", "min":100, "max":300, "step":5}'
    - '// @input float arcRadiusCm = 300 {"hint":"Mean distance of the arc from the user in cm (stays roughly 2-4 m away).", "widget":"slider", "min":200, "max":400, "step":5}'
    - '// @input float arcHalfAngleDeg = 15 {"hint":"How far the arc swings either side of straight ahead, in degrees.", "widget":"slider", "min":5, "max":30, "step":1}'
    - '// @input float eyeHeightCm = 165 {"hint":"User eye height in cm, used to find the floor when placing content at Lens start.", "widget":"slider", "min":120, "max":200, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input float debugTimeScale = 1 {"hint":"Simulation speed multiplier for testing only (1 = real time). Not exposed in the HUD.", "widget":"slider", "min":0.25, "max":10, "step":0.25}'
    - "// @input bool placeContentAtStart = true {\"hint\":\"Place ContentRoot relative to the user's head at Lens start (off = keep authored placement).\"}"
    - '// @ui {"widget":"group_end"}'
